// UpSycle — Prisma schema
// Postgres (Amazon RDS) via Prisma ORM, per tech-stack-recommendation.md
//
// Scope: Phase 0 (issue #4) + Phase 1 field-level detail from mvp-build-plan.md.
// Deliberately NOT modeled (Phase 2 backlog, do not block adding later):
//   - subscription tiers (seller featured-placement ranking)
//   - private buyer<->seller messaging (public product Q&A is modeled below —
//     ProductQuestion — but a private DM channel is a separate, deferred scope)
//   - buyer reviews on purchased items
//   - "recommended items" personalization state
//   - admin analytics dashboard aggregates (derivable from Order/Product/User via queries)
//
// Auth: Amazon Cognito owns credentials (passwords, OTP/password-reset flow, sessions).
// This schema stores only a Cognito user id (`cognitoSub`) on User — no password field.

generator client {
  provider      = "prisma-client-js"
  // "native" is correct now that the app deploys as a Docker container
  // (see infra/lib/stacks/apprunner-stack.ts + Dockerfile): `prisma
  // generate` runs inside the same build stage/base image the app actually
  // runs in, so there's no cross-platform binary mismatch the way there was
  // deploying to Amplify Hosting's Lambda-based "Web Compute" runtime
  // (which needed an explicit rhel-openssl-3.0.x target — no longer
  // applicable, see git history for that saga).
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & roles
// ---------------------------------------------------------------------------

// Multi-role design rationale:
// Requirement.MD is explicit that "user can hold multiple roles" (buyer/seller/admin
// simultaneously). Modeling role as a single enum field on User would make holding
// more than one role impossible (or require hacky combined enum values like
// "BUYER_SELLER"). Instead we use a join table (UserRole) between User and a Role
// enum, giving each user zero-to-many roles. SellerProfile is a separate 1:1 table
// (not folded into User) because it only exists/is populated once a user takes on
// the seller role and goes through vetting — keeping it separate avoids a wide User
// table full of nullable seller-only columns and lets us attach an approval
// workflow (pending/approved/suspended) that has no meaning for pure buyers.
model User {
  id         String   @id @default(uuid())
  cognitoSub String   @unique // Cognito user pool "sub" — Cognito owns credentials
  email      String   @unique
  firstName  String?
  lastName   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  roles         UserRole[]
  addresses     Address[]
  sellerProfile SellerProfile?
  orders        Order[]        @relation("BuyerOrders")

  referralsSent     SellerReferral[] @relation("ReferrerUser")
  referralsReceived SellerReferral[] @relation("ReferralUser")

  questionsAsked    ProductQuestion[] @relation("QuestionAsker")
  questionsAnswered ProductQuestion[] @relation("QuestionAnswerer")

  @@map("users")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

// Join table giving each User zero-to-many Roles (see rationale above).
model UserRole {
  id     String @id @default(uuid())
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Seller vetting
// ---------------------------------------------------------------------------

enum SellerApprovalStatus {
  PENDING
  APPROVED
  SUSPENDED
}

// Paid subscription tier a seller applies under / can change from their
// dashboard. See TierPlan below for the actual pricing/benefit data this
// value keys into.
enum SellerTier {
  TIER_1
  TIER_2
  TIER_3
}

// Data-driven per-tier pricing/benefit config, one row per SellerTier value.
// Deliberately NOT hardcoded as enum-branching logic anywhere in app code —
// every tier-gated behavior (billing price, benefit copy, search rank boost)
// reads these columns, so pricing/benefits can be corrected later (Prisma
// Studio, a raw UPDATE, or a future admin editor) with zero redeploy.
// Tier 2/3 ship with all benefit fields zeroed/null and isPricingFinalized =
// false because Prompts/Tier_system.md never defines them — code that
// presents tier benefits/pricing as final (seller portal copy, search
// ranking weight) must check isPricingFinalized rather than assume these
// placeholder zeros are real product decisions.
model TierPlan {
  id                        String     @id @default(uuid())
  tier                      SellerTier @unique
  name                      String
  monthlyPriceCents         Int        @default(0) // 0 = free tier (valid — Tier_system.md never finishes the billing-trigger sentence, so a $0 tier is a legitimate outcome, not a bug)
  quarterlySalesTargetCents Int? // null = no target defined yet (Tier 2/3)
  lotteryEntriesPerPeriod   Int        @default(0)
  socialPostsPerPeriod      Int        @default(0)
  benefitPeriodDays         Int        @default(30) // assumed monthly cadence — spec never states one
  canHighlightProducts      Boolean    @default(false)
  searchRankWeight          Int        @default(0) // mirrored onto SellerProfile.searchRankWeight for /browse ordering — see that field's comment
  isPricingFinalized        Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions SellerSubscription[]
  tierChanges   SellerTierChange[]

  @@map("tier_plans")
}

enum SellerSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  COMPED // admin-granted or $0-tier — no real Stripe subscription behind it
}

// The real, billing-aware record behind a seller's tier — one per
// SellerProfile. SellerProfile.tier/searchRankWeight remain denormalized read
// caches (see those fields) kept in sync from here inside the same
// transaction as every write (see lib/seller-billing.ts), so the cache can
// never drift from this source of truth.
model SellerSubscription {
  id                   String                   @id @default(uuid())
  sellerProfileId      String                   @unique
  tierPlanId           String
  status               SellerSubscriptionStatus @default(COMPED)
  stripeCustomerId     String?
  stripeSubscriptionId String?                  @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean                  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  tierPlan      TierPlan      @relation(fields: [tierPlanId], references: [id], onDelete: Restrict)

  @@map("seller_subscriptions")
}

enum TierChangeReason {
  SELLER_CHECKOUT // seller subscribed/changed tier themselves via Stripe Checkout
  STRIPE_SYNC // webhook-driven change (portal upgrade/downgrade/cancel)
  ADMIN_OVERRIDE // admin comp, no Stripe involved
  SEED_BACKFILL // demo-data / migration backfill row
}

// Append-only audit trail of every tier transition, however it happened.
model SellerTierChange {
  id              String           @id @default(uuid())
  sellerProfileId String
  fromTier        SellerTier?
  toTier          SellerTier
  reason          TierChangeReason
  changedByUserId String? // admin User.id for ADMIN_OVERRIDE; null for STRIPE_SYNC/SEED_BACKFILL
  stripeEventId   String?          @unique // dedupes webhook retries; Postgres allows multiple NULLs in a unique index
  note            String? // admin override reason, or null
  createdAt       DateTime         @default(now())

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  tierPlan      TierPlan      @relation(fields: [toTier], references: [tier], onDelete: Restrict)

  @@map("seller_tier_changes")
}

model SellerProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Readable storefront URL segment (/sellers/[slug]) — generated once at
  // application time from the applicant's name/email (see lib/slug.ts) since
  // a raw SellerProfile.id guid isn't something a seller can share with
  // customers. Immutable after creation to avoid breaking links a seller has
  // already shared.
  slug String @unique

  // Paragraph the seller writes about themselves/their shop. Collected at
  // application time but editable afterward from the seller dashboard
  // (app/(seller)/sell/profile) — unlike the rest of SellerProfile's
  // application-vetting fields, this is customer-facing copy shown on the
  // seller's storefront page, so it's expected to be kept up to date.
  story String?

  websiteUrl           String?
  socialMediaUrls      String[] // multiple social accounts allowed
  expectedMonthlySales Int? // expected volume of sales per month
  supplierList         String[] // e.g. "Home Depot", "Hobby Lobby"
  approvalStatus       SellerApprovalStatus @default(PENDING)
  // Denormalized read cache of SellerSubscription.tierPlan.tier — kept in
  // sync (same transaction) by lib/seller-billing.ts's applyTierChange on
  // every subscribe/upgrade/downgrade/cancel/admin-override. Exists because
  // this value is read directly, cheaply, in hot paths (admin table, seller
  // portal, /browse ordering) that shouldn't each join through
  // SellerSubscription -> TierPlan. SellerSubscription is the source of
  // truth; never write this field outside applyTierChange.
  tier                 SellerTier           @default(TIER_1)
  // Denormalized copy of TierPlan.searchRankWeight for the seller's current
  // tier — lets /browse's Product query sort with a single 1-level relation
  // orderBy (sellerProfile.searchRankWeight) instead of a 2-level join
  // through SellerSubscription -> TierPlan on every listing request. Synced
  // by the same applyTierChange helper as `tier` above.
  searchRankWeight     Int                  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  samplePhotos SellerSamplePhoto[]
  products     Product[]
  orderItems   OrderItem[]
  subscription SellerSubscription?
  tierChanges  SellerTierChange[]

  @@map("seller_profiles")
}

// The 5 required sample product photos submitted at seller signup for vetting.
model SellerSamplePhoto {
  id              String   @id @default(uuid())
  sellerProfileId String
  url             String // S3 object URL/key
  createdAt       DateTime @default(now())

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@map("seller_sample_photos")
}

// Referral tracking: an existing seller (referrer) refers a new artisan (referral).
// Kept minimal for Phase 0/1 (linkage only) — invite-email generation is Phase 2 #4.
model SellerReferral {
  id            String   @id @default(uuid())
  referrerId    String // existing seller's User.id
  referralId    String?  @unique // new artisan's User.id once they sign up (nullable until claimed)
  referralEmail String // email the invite was addressed to
  createdAt     DateTime @default(now())

  referrer User  @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)
  referral User? @relation("ReferralUser", fields: [referralId], references: [id], onDelete: SetNull)

  @@map("seller_referrals")
}

// ---------------------------------------------------------------------------
// Addresses
// ---------------------------------------------------------------------------

model Address {
  id         String  @id @default(uuid())
  userId     String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("US")
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ordersShipped Order[] @relation("ShippingAddress")

  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Categories (self-referential tree)
// ---------------------------------------------------------------------------

// Matches: Jewelry>{necklace,earring,bracelet,other},
// Home Goods>{woodworking,glassblowing,pottery,other}, Furniture>{dresser,table,chair,other}.
// Self-referential parent/children keeps the tree data-driven (seeded) rather than
// hardcoded, so future top-level categories or subcategories don't require a schema change.
model Category {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  parentId String?

  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryToSubcategory")
  products Product[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

model Product {
  id              String @id @default(uuid())
  sellerProfileId String
  categoryId      String

  title             String
  description       String
  priceCents        Int // price of item, stored as integer cents
  shippingCostCents Int
  offersLocalPickup Boolean @default(false) // seller opt-in; buyer's approximate location shown is the seller's default Address city/state, never a full street address
  dimensions        String? // free-form e.g. "10x8x4 in" — no fixed unit schema requested
  weightGrams       Int?
  inventoryCount    Int     @default(0)

  proofOfHandcraftedUrl String // required proof-of-handcrafted upload (S3 key/URL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerProfile SellerProfile     @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  photos        ProductPhoto[]
  orderItems    OrderItem[]
  questions     ProductQuestion[]

  @@map("products")
}

// 2-6 product photos per listing (count enforced at the application layer).
model ProductPhoto {
  id        String   @id @default(uuid())
  productId String
  url       String // S3 object URL/key
  position  Int      @default(0) // display order
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_photos")
}

// ---------------------------------------------------------------------------
// Product Q&A (public)
// ---------------------------------------------------------------------------

// Public buyer<->seller Q&A on a product page (Amazon/Etsy-style): a buyer
// asks, the product's seller answers, and both are visible to every visitor.
// Deliberately smaller in scope than private messaging (see header comment) —
// answer fields live inline on the question row rather than a separate
// Answer table, since a question has at most one seller-authored answer for
// this pass. Append-only from the buyer's side (no edit/delete) like
// ProductPhoto/OrderItem; a seller may re-answer (overwrite) to fix a typo.
model ProductQuestion {
  id           String    @id @default(uuid())
  productId    String
  askedById    String
  questionText String
  answerText   String?
  answeredById String?
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  askedBy    User    @relation("QuestionAsker", fields: [askedById], references: [id], onDelete: Cascade)
  answeredBy User?   @relation("QuestionAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)

  @@map("product_questions")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum ShippingStatus {
  PENDING_SHIPMENT
  SHIPPED
  DELIVERED
  CANCELLED
}

// Per-line-item fulfillment choice made by the buyer at checkout (only
// offered when the Product has offersLocalPickup = true). Deliberately not
// folded into ShippingStatus — that enum tracks shipment progress, this
// tracks which fulfillment path was chosen at all; display layers relabel
// ShippingStatus values (e.g. "Ready for Pickup" instead of "Pending
// Shipment") based on this field rather than adding pickup-specific
// ShippingStatus values.
enum FulfillmentMethod {
  SHIP
  PICKUP
}

model Order {
  id                String  @id @default(uuid())
  buyerId           String
  shippingAddressId String? // nullable: an all-pickup order has no items to ship, so no address is collected

  // Whole-order convenience status (e.g. for a buyer's order-history list).
  // Authoritative shipment tracking is per-line-item (see OrderItem below),
  // since a single cart/order can span multiple sellers who ship
  // independently — this field is a derived/display aggregate, not the
  // thing sellers update directly.
  shippingStatus   ShippingStatus @default(PENDING_SHIPMENT)
  totalAmountCents Int
  stripePaymentId  String? // Stripe Connect payment intent/charge reference

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer           User        @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  shippingAddress Address?    @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: Restrict)
  items           OrderItem[]

  @@map("orders")
}

// Line item — links an Order to a Product (and denormalizes the seller for querying
// "products sold this month" / "pending shipment" per seller without joining through
// Product, which could later be edited/discontinued).
model OrderItem {
  id              String @id @default(uuid())
  orderId         String
  productId       String
  sellerProfileId String

  quantity          Int @default(1)
  unitPriceCents    Int // price at time of purchase (snapshot, independent of later Product edits)
  shippingCostCents Int // 0 when fulfillmentMethod is PICKUP

  fulfillmentMethod FulfillmentMethod @default(SHIP)

  // Per-line-item shipment tracking. A single Order can contain items from
  // multiple sellers, each of whom ships independently — so "mark as
  // shipped" (issue #13) must act here, not on Order.shippingStatus.
  shippingStatus ShippingStatus @default(PENDING_SHIPMENT)

  createdAt DateTime @default(now())

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)

  @@map("order_items")
}
