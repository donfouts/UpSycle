# Local Postgres connection string for Prisma.
# Copy this file to .env and fill in real values — .env is gitignored.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/upsycle?schema=public"

# Amazon Cognito User Pool — provisioned by the parallel CDK-infra branch.
# Auth (signup/login/OTP password reset) is handled entirely by Cognito; this
# app never stores or validates passwords itself. See lib/cognito.ts.
COGNITO_REGION="us-west-2"
COGNITO_USER_POOL_ID="us-west-2_XXXXXXXXX"
COGNITO_USER_POOL_CLIENT_ID="XXXXXXXXXXXXXXXXXXXXXXXXXX"

# Amazon S3 — seller sample-photo, product-photo, and proof-of-handcrafted
# uploads (bucket not deployed yet). All three use this same bucket under
# distinct key prefixes (see app/api/upload/route.ts). Used by lib/s3.ts.
# Falls back to COGNITO_REGION if unset.
AWS_REGION="us-west-2"
PHOTOS_BUCKET_NAME=""

# Stripe — cart checkout (issue #11). No live Stripe account/Connect
# platform exists yet; these are placeholders until one is provisioned. See
# app/api/checkout/route.ts for the payout-approach tradeoff this was built
# against (single platform-account charge; per-seller Connect payouts are a
# documented follow-up, not yet implemented).
STRIPE_SECRET_KEY="sk_test_XXXXXXXXXXXXXXXXXXXXXXXX"
STRIPE_PUBLISHABLE_KEY="pk_test_XXXXXXXXXXXXXXXXXXXXXXXX"
# Signing secret for the /api/webhooks/stripe endpoint (from the Stripe CLI
# in dev, or the Dashboard webhook config in production).
STRIPE_WEBHOOK_SECRET="whsec_XXXXXXXXXXXXXXXXXXXXXXXX"
