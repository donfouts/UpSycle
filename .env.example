# Local Postgres connection string for Prisma.
# Copy this file to .env and fill in real values — .env is gitignored.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/upsycle?schema=public"

# Amazon Cognito User Pool — provisioned by the parallel CDK-infra branch.
# Auth (signup/login/OTP password reset) is handled entirely by Cognito; this
# app never stores or validates passwords itself. See lib/cognito.ts.
COGNITO_REGION="us-east-1"
COGNITO_USER_POOL_ID="us-east-1_XXXXXXXXX"
COGNITO_USER_POOL_CLIENT_ID="XXXXXXXXXXXXXXXXXXXXXXXXXX"

# Amazon S3 — seller sample-photo uploads (bucket not deployed yet). Used by
# lib/s3.ts + app/api/upload/route.ts. Falls back to COGNITO_REGION if unset.
AWS_REGION="us-east-1"
PHOTOS_BUCKET_NAME=""
