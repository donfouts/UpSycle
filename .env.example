# Local Postgres connection string for Prisma.
# Copy this file to .env and fill in real values — .env is gitignored.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/upsycle?schema=public"

# Amazon Cognito — auth (user pool + app client not deployed yet; see
# feature/buyer-auth for the real infra). Used by lib/cognito.ts.
COGNITO_REGION="us-east-1"
COGNITO_USER_POOL_ID=""
COGNITO_USER_POOL_CLIENT_ID=""

# Amazon S3 — seller sample-photo uploads (bucket not deployed yet). Used by
# lib/s3.ts + app/api/upload/route.ts. Falls back to COGNITO_REGION if unset.
AWS_REGION="us-east-1"
PHOTOS_BUCKET_NAME=""
