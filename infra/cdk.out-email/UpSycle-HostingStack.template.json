{
 "Description": "UpSycle: Amplify Hosting app wired to GitHub for CI/CD (issue #3)",
 "Resources": {
  "UpSycleAmplifyApp": {
   "Type": "AWS::Amplify::App",
   "Properties": {
    "AccessToken": "{{resolve:secretsmanager:arn:aws:secretsmanager:us-west-2:506145782106:secret:upsycle/amplify/github-access-token:SecretString:::}}",
    "BuildSpec": "version: 1\napplications:\n  - appRoot: Web/UpSycle\n    frontend:\n      phases:\n        preBuild:\n          commands:\n            - npm ci\n            - npx prisma generate\n        build:\n          commands:\n            - npm run build\n      artifacts:\n        baseDirectory: .next\n        files:\n          - '**/*'\n      cache:\n        paths:\n          - node_modules/**/*\n          - .next/cache/**/*",
    "CustomRules": [
     {
      "Source": "/<*>",
      "Status": "404-200",
      "Target": "/index.html"
     }
    ],
    "EnvironmentVariables": [
     {
      "Name": "AMPLIFY_MONOREPO_APP_ROOT",
      "Value": "Web/UpSycle"
     },
     {
      "Name": "AMPLIFY_DIFF_DEPLOY",
      "Value": "false"
     }
    ],
    "Name": "upsycle-web",
    "Platform": "WEB_COMPUTE",
    "Repository": "https://github.com/donfouts/UpSycle",
    "Tags": [
     {
      "Key": "project",
      "Value": "UpSycle"
     }
    ]
   },
   "Metadata": {
    "aws:cdk:path": "UpSycle-HostingStack/UpSycleAmplifyApp"
   }
  },
  "MainBranch": {
   "Type": "AWS::Amplify::Branch",
   "Properties": {
    "AppId": {
     "Fn::GetAtt": [
      "UpSycleAmplifyApp",
      "AppId"
     ]
    },
    "BranchName": "main",
    "EnableAutoBuild": true,
    "Stage": "PRODUCTION",
    "Tags": [
     {
      "Key": "project",
      "Value": "UpSycle"
     }
    ]
   },
   "Metadata": {
    "aws:cdk:path": "UpSycle-HostingStack/MainBranch"
   }
  },
  "CDKMetadata": {
   "Type": "AWS::CDK::Metadata",
   "Properties": {
    "Analytics": "v2:deflate64:H4sIAAAAAAAA/yXGTQqDMBBA4bO4T0abhfvWAwj2AGWMCR1/xpBJKiLeXaTw4HsGTP2AqsBNtB0mPVMPxzuhnVTnZM3ROoWbfHAJM/kdjsbzMwTVeH5FZPs9721zCjmditfBwSjlz1RwV4xCpGPmRIuD7u8FbbjN2nMAAAA="
   },
   "Metadata": {
    "aws:cdk:path": "UpSycle-HostingStack/CDKMetadata/Default"
   }
  }
 },
 "Outputs": {
  "AmplifyAppId": {
   "Value": {
    "Fn::GetAtt": [
     "UpSycleAmplifyApp",
     "AppId"
    ]
   }
  },
  "AmplifyDefaultDomain": {
   "Value": {
    "Fn::Join": [
     "",
     [
      "main.",
      {
       "Fn::GetAtt": [
        "UpSycleAmplifyApp",
        "AppId"
       ]
      },
      ".amplifyapp.com"
     ]
    ]
   }
  },
  "ExportsOutputFnGetAttUpSycleAmplifyAppAppIdD6CF1512": {
   "Value": {
    "Fn::GetAtt": [
     "UpSycleAmplifyApp",
     "AppId"
    ]
   },
   "Export": {
    "Name": "UpSycle-HostingStack:ExportsOutputFnGetAttUpSycleAmplifyAppAppIdD6CF1512"
   }
  }
 },
 "Parameters": {
  "BootstrapVersion": {
   "Type": "AWS::SSM::Parameter::Value<String>",
   "Default": "/cdk-bootstrap/hnb659fds/version",
   "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]"
  }
 },
 "Rules": {
  "CheckBootstrapVersion": {
   "Assertions": [
    {
     "Assert": {
      "Fn::Not": [
       {
        "Fn::Contains": [
         [
          "1",
          "2",
          "3",
          "4",
          "5"
         ],
         {
          "Ref": "BootstrapVersion"
         }
        ]
       }
      ]
     },
     "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI."
    }
   ]
  }
 }
}